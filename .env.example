# AI-Based Server-Client Load Balancer - Deployment Configuration Template
# Copy to .env and customize as needed for your deployment environment

# Load Balancer Host and Public Exposure Port on Host
LB_HOST=0.0.0.0
LB_PORT=8000

# Central Routing Algorithm
# Options: round_robin, least_connections, ip_hash, ml, priority_ml, adaptive, priority_adaptive
ROUTING_ALGORITHM=round_robin

# Adaptive Strategy (when ROUTING_ALGORITHM is 'adaptive' or 'priority_adaptive')
# Options: policy, meta
ADAPTIVE_STRATEGY=policy

# ML Model Artifact Path (relative to project root)
MODEL_PATH=models/logistic_regression.joblib

# Per-Request Backend HTTP Timeout (in seconds)
BACKEND_TIMEOUT=2.0

# Comma-Separated Backend Server Target URLs
# For Docker Compose (Internal Network):
BACKENDS=http://server-1:8001,http://server-2:8002,http://server-3:8003
# For Local Host Execution:
# BACKENDS=http://127.0.0.1:8001,http://127.0.0.1:8002,http://127.0.0.1:8003

